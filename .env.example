# Copie este arquivo para ".env" (ou configure essas variáveis direto no painel
# do serviço de hospedagem, ex: PythonAnywhere) na hora do deploy.
# Localmente, para rodar com "python manage.py runserver", NADA disso é obrigatório —
# o projeto já tem valores padrão seguros para desenvolvimento.

# Chave secreta do Django. Gere uma nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-por-uma-chave-gerada-so-sua

# Sempre False em produção.
DJANGO_DEBUG=False

# Domínio(s) onde o site vai rodar, separados por vírgula, sem http:// e sem barra no final.
DJANGO_ALLOWED_HOSTS=seuprojetoo.pythonanywhere.com

# Configuração de e-mail (opcional). Se DEIXAR EM BRANCO, o sistema usa o backend de
# console (só imprime o e-mail no terminal, não envia de verdade — bom para testar).
# Preencha estes 4 campos para enviar e-mails reais (ex: recuperação de senha):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
